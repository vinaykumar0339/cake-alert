# Copy values into `.env.dev` or `.env.production` based on the environment.

# Slack bot token is loaded from macOS Keychain.
ADMIN_SLACK_USER_IDS=VinayMemberId
# Comma-separated Slack channel IDs or user IDs where wishes should be posted
WISHES_SLACK_TARGET_IDS=C0123456789

# Required Google Sheet target
GOOGLE_SHEET_ID=sheetId
GOOGLE_SHEET_NAME=Sheet1

# Vymo Wishes Slack bot token and Google OAuth secrets are loaded from macOS Keychain.
# Store them with:
# SLACK_BOT_TOKEN=... GOOGLE_OAUTH_CLIENT_ID=... GOOGLE_OAUTH_CLIENT_SECRET=... GOOGLE_OAUTH_REFRESH_TOKEN=... pnpm setup:keychain
# Delete them with:
# pnpm delete:keychain

# Cron for the currently loaded environment
BIRTHDAY_WISH_CRON=0 9 * * *
