# Required: Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
ADMIN_SLACK_USER_IDS=VinayMemberId

# Required in production and default mode
GOOGLE_SHEET_ID=sheetId
GOOGLE_SHEET_NAME=Sheet1

# Optional development override (no Google credentials needed)
# Enable only for local/dev testing with a public sheet
NODE_ENV=development
GOOGLE_SHEET_PUBLIC_CSV_URL=https://docs.google.com/spreadsheets/d/<sheeid>/gviz/tq?tqx=out:csv&sheet=Sheet1

# Optional production cron overrides
# Birthday wishes: defaults to 9:00 AM daily in production
BIRTHDAY_WISH_CRON=0 9 * * *
# Sheet sync: defaults to every 15 minutes in production
SHEET_SYNC_CRON=*/15 * * * *

# Development behavior is fixed in code:
# - Birthday wishes every 1 minute
# - Sheet sync every 2 minutes

# Google auth (recommended in Docker/prod when using GOOGLE_SHEET_ID + GOOGLE_SHEET_NAME)
# Mount service account JSON and set this path
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
